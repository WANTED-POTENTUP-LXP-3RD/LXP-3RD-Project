### Course & Section API 테스트
### 기본 설정: localhost:8080 (필요시 수정)

@baseUrl = http://localhost:8080
@courseId = 1
@sectionId = 1
@instructorId = 1
@categoryId = 1

##############################################
### Course API
##############################################

### 1. 강의 생성
POST {{baseUrl}}/api/instructor/courses?instructorId={{instructorId}}
Content-Type: application/json

{
  "title": "Spring Boot 완전 정복",
  "categoryId": {{categoryId}},
  "summary": "Spring Boot를 활용한 웹 애플리케이션 개발",
  "description": "이 강의는 Spring Boot를 처음 배우는 분들을 위한 강의입니다. 기본 개념부터 실전 프로젝트까지 단계별로 학습할 수 있습니다.",
  "thumbnailUrl": "https://example.com/thumbnail.jpg",
  "price": 50000,
  "courseLevel": "BEGINNER"
}

### 2. 강의 수정
PATCH {{baseUrl}}/api/instructor/courses/{{courseId}}?instructorId={{instructorId}}
Content-Type: application/json

{
  "title": "수정된 강의 제목",
  "summary": "수정된 한 줄 요약",
  "price": 60000
}

### 3. 강의 목록 조회 (강사용)
GET {{baseUrl}}/api/instructor/courses?instructorId={{instructorId}}&page=0&size=10

##############################################
### Section API
##############################################

### 4. 섹션 생성
POST {{baseUrl}}/api/instructor/courses/{{courseId}}/sections?instructorId={{instructorId}}
Content-Type: application/json

{
  "title": "섹션 제목",
  "orderIndex": 2
}

### 5. 섹션 생성 (다른 순서)
POST {{baseUrl}}/api/instructor/courses/{{courseId}}/sections?instructorId={{instructorId}}
Content-Type: application/json

{
  "title": "두 번째 섹션",
  "orderIndex": 2
}

### 6. 섹션 수정
PATCH {{baseUrl}}/api/instructor/courses/{{courseId}}/sections/{{sectionId}}?instructorId={{instructorId}}
Content-Type: application/json

{
  "title": "수정된 섹션 제목",
  "orderIndex": 1
}

### 7. 섹션 수정 (제목만)
PATCH {{baseUrl}}/api/instructor/courses/{{courseId}}/sections/{{sectionId}}?instructorId={{instructorId}}
Content-Type: application/json

{
  "title": "제목만 수정"
}

### 8. 섹션 수정 (순서만)
PATCH {{baseUrl}}/api/instructor/courses/{{courseId}}/sections/{{sectionId}}?instructorId={{instructorId}}
Content-Type: application/json

{
  "orderIndex": 3
}

