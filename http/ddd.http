### Progress / Enrollment 확장 테스트 (IntelliJ HTTP Client)
### 각 요청의 ▶ 버튼을 순서대로 실행하세요.

### 변수 설정
@baseUrl = http://localhost:8080
@contentType = application/json

@testEmail = test2@example.com
@testPassword = password123
@testNickName = testuser2

##########################################
### 0. 인증 (토큰 확보)
##########################################

### 0-1. 회원가입 + 자동 로그인 (이미 가입된 계정이면 실패 가능)
# @name signupAndLogin
POST {{baseUrl}}/api/auth/signup-and-login
Content-Type: {{contentType}}

{
  "nickname": "{{testNickName}}",
  "email": "{{testEmail}}",
  "password": "{{testPassword}}"
}

> {%
    if (response.status === 200 && response.body.data) {
        client.global.set("accessToken", response.body.data.accessToken);
        client.global.set("refreshToken", response.body.data.refreshToken);
    }
%}

### 0-2. 로그인 (0-1 실패 시 실행)
# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: {{contentType}}

{
  "email": "{{testEmail}}",
  "password": "{{testPassword}}"
}

> {%
    client.global.set("accessToken", response.body.data.accessToken);
    client.global.set("refreshToken", response.body.data.refreshToken);
%}

##########################################
### 1. 강사 권한 부여
##########################################

### 1-1. 강사 권한 추가
# @name addInstructorRole
PATCH {{baseUrl}}/api/users/me/roles/instructor
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

##########################################
### 2. 카테고리 조회
##########################################

### 2-1. 카테고리 목록
# @name getCategories
GET {{baseUrl}}/api/categories

> {%
    const list = response.body.data;
    if (list && list.length > 0) {
        client.global.set("categoryId", list[0].categoryId);
    }
%}

##########################################
### 3. 강좌/섹션/강의 생성 (리소스 3개)
##########################################

### 3-1. 강좌 생성
# @name createCourse
POST {{baseUrl}}/api/instructor/courses
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "title": "진도율 확장 테스트 강좌",
  "categoryId": {{categoryId}},
  "summary": "progress 계산 확장 테스트",
  "description": "다중 리소스/예외 케이스 검증",
  "price": 10000,
  "thumbnailResourceKey": "qwlkeqe.url",
  "courseLevel": "BEGINNER"
}

> {%
    if (response.body.data) {
        client.global.set("courseId", response.body.data.courseId);
    }
%}

### 3-2. 섹션 생성
# @name createSection
POST {{baseUrl}}/api/instructor/courses/{{courseId}}/sections
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "title": "섹션 1",
  "orderIndex": 1
}

> {%
    if (response.body.data) {
        client.global.set("sectionId", response.body.data.sectionId);
    }
%}

##########################################
### 4. 리소스 생성 (VIDEO 3개)
##########################################

### 4-1. 리소스 1 (video/mp4, duration 120)
# @name createResource1
POST {{baseUrl}}/api/instructor/resources
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "fileName": "lecture1.mp4",
  "contentType": "video/mp4",
  "size": 1024,
  "duration": 120,
  "isDownloadable": false
}

> {%
    if (response.body.data) {
        client.global.set("resourceKey1", response.body.data.key);
    }
%}

### 4-2. 리소스 2 (video/mp4, duration 240)
# @name createResource2
POST {{baseUrl}}/api/instructor/resources
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "fileName": "lecture2.mp4",
  "contentType": "video/mp4",
  "size": 2048,
  "duration": 240,
  "isDownloadable": false
}

> {%
    if (response.body.data) {
        client.global.set("resourceKey2", response.body.data.key);
    }
%}

### 4-3. 리소스 3 (video/mp4, duration 300)
# @name createResource3
POST {{baseUrl}}/api/instructor/resources
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "fileName": "lecture3.mp4",
  "contentType": "video/mp4",
  "size": 3072,
  "duration": 300,
  "isDownloadable": false
}

> {%
    if (response.body.data) {
        client.global.set("resourceKey3", response.body.data.key);
    }
%}

##########################################
### 5. 강의 생성 (리소스 연결)
##########################################

### 5-1. 강의 1 생성
# @name createLecture1
POST {{baseUrl}}/api/instructor/courses/{{courseId}}/sections/{{sectionId}}/lectures
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "title": "강의 1",
  "isPreview": false,
  "orderIndex": 1,
  "resourceKey": "{{resourceKey1}}"
}

> {%
    if (response.body.data && response.body.data.resource) {
        client.global.set("resourceId1", response.body.data.resource.resourceId);
    }
%}

### 5-2. 강의 2 생성
# @name createLecture2
POST {{baseUrl}}/api/instructor/courses/{{courseId}}/sections/{{sectionId}}/lectures
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "title": "강의 2",
  "isPreview": false,
  "orderIndex": 2,
  "resourceKey": "{{resourceKey2}}"
}

> {%
    if (response.body.data && response.body.data.resource) {
        client.global.set("resourceId2", response.body.data.resource.resourceId);
    }
%}

### 5-3. 강의 3 생성
# @name createLecture3
POST {{baseUrl}}/api/instructor/courses/{{courseId}}/sections/{{sectionId}}/lectures
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "title": "강의 3",
  "isPreview": false,
  "orderIndex": 3,
  "resourceKey": "{{resourceKey3}}"
}

> {%
    if (response.body.data && response.body.data.resource) {
        client.global.set("resourceId3", response.body.data.resource.resourceId);
    }
%}

##########################################
### 6. 강좌 Publish
##########################################

### 6-1. 강좌 공개
# @name publishCourse
PATCH {{baseUrl}}/api/instructor/courses/{{courseId}}/publish
Authorization: Bearer {{accessToken}}

##########################################
### 7. 결제 → 자동 수강
##########################################

### 7-1. 결제 준비
# @name preparePayment
POST {{baseUrl}}/api/payments/prepare
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "items": [
    { "courseId": {{courseId}} }
  ]
}

> {%
    if (response.body.data) {
        client.global.set("orderId", response.body.data.orderId);
        client.global.set("amount", response.body.data.amount);
        client.global.set("paymentKey", "test-payment-" + response.body.data.orderId);
    }
%}

### 7-2. 결제 승인
# @name confirmPayment
POST {{baseUrl}}/api/payments/confirm
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "orderId": "{{orderId}}",
  "amount": {{amount}},
  "paymentKey": "{{paymentKey}}"
}

##########################################
### 8. 수강 생성 확인
##########################################

### 8-1. 내 수강 목록 조회
# @name getEnrollments
GET {{baseUrl}}/api/enrollments?page=0&size=10
Authorization: Bearer {{accessToken}}

> {%
    const content = response.body.data && response.body.data.content;
    if (content && content.length > 0) {
        client.global.set("enrollmentId", content[0].enrollmentId);
    }
%}

##########################################
### 9. Progress 계산 검증 (다중 리소스 평균)
##########################################

### 9-1. 강의 1 시청 120초 (100%)
# @name updateProgress1
PATCH {{baseUrl}}/api/progresses/course/{{courseId}}
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "resourceId": {{resourceId1}},
  "watchedDuration": 120
}

### 9-2. 강의 2 시청 120초 (50%)
# @name updateProgress2
PATCH {{baseUrl}}/api/progresses/course/{{courseId}}
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "resourceId": {{resourceId2}},
  "watchedDuration": 60
}

### 9-3. 강의 3 시청 150초 (50%)
# @name updateProgress3
PATCH {{baseUrl}}/api/progresses/course/{{courseId}}
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "resourceId": {{resourceId3}},
  "watchedDuration": 150
}